---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import about from '../data/about.json';
import settings from '../data/settings.json';
import home from '../data/home.json';
---

<BaseLayout title="About | Marshall Automotive LLC" description="Marshall Automotive LLC is a family-owned auto repair shop on Lebanon Pike in Hermitage, TN.">
  <section class="page-hero" style={`background-image:url('${home.hero_image}')`}>
    <div class="container">
      <p class="eyebrow">Honest Work. Real Results.</p>
      <h1>{about.title}</h1>
      <p>{about.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-2">
        <div>
          <h2 style="font-size:clamp(1.6rem,2.6vw,2.2rem)">Our Story</h2>
          <div class="rule"></div>
          <p>{about.body_1}</p>
          <p>{about.body_2}</p>
          <p>{about.body_3}</p>
          <div class="signature">{about.signature}</div>
          <div class="owner-line">{about.owner}</div>
        </div>
        <div class="angled-image" style="min-height:420px;">
          <svg class="edge" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <line x1="16" y1="0" x2="0" y2="100" />
          </svg>
          <img src={about.image} alt="Inside the Marshall Automotive shop" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" style="background:#0a0a0a;">
    <div class="container">
      <h2 style="font-size:clamp(1.6rem,2.6vw,2.2rem)">What We Stand For</h2>
      <div class="rule"></div>
      <div class="grid-2" style="align-items:stretch;">
        {
          about.values.map((v) => (
            <article class="service-detail">
              <Icon name="check" size={30} class="icon-green" />
              <div>
                <h3>{v.title}</h3>
                <p>{v.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-2" style="align-items:start;">
        <div class="panel panel--green-edge">
          <h2 style="font-size:1.5rem">Shop Hours</h2>
          <div class="rule"></div>
          <ul class="hours-list">
            {
              settings.hours.map((h) => (
                <li>
                  <span class="day">{h.days}</span>
                  <span class="time">{h.time}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="panel panel--green-edge">
          <h2 style="font-size:1.5rem">Find Us</h2>
          <div class="rule"></div>
          <ul class="footer-contact">
            <li>
              <Icon name="pin" size={20} />
              <span>{settings.address_line1}<br />{settings.address_line2}</span>
            </li>
            <li>
              <Icon name="phone" size={20} />
              <a href={settings.phone_link}>{settings.phone}</a>
            </li>
            <li>
              <Icon name="mail" size={20} />
              <a href={`mailto:${settings.email}`}>{settings.email}</a>
            </li>
          </ul>
          <a class="btn btn--sm" href={settings.map_url} target="_blank" rel="noopener" style="margin-top:12px;">
            Get Directions
            <span class="btn-arrow"><Icon name="chevron" size={18} /></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
